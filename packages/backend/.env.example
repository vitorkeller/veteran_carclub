DATABASE_URL=postgres://veteran_carclub:veteran_carclub@localhost:5432/veteran_carclub
# ↑ Postgres local (padrão). Para apontar para o Supabase Postgres, use a
# connection string do "Transaction pooler" (porta 6543) do painel do
# projeto — passo a passo em rotas.md.
PORT=3001
# Troque por um valor aleatório longo em produção (ex.: `openssl rand -hex 32`).
JWT_SECRET=troque-este-valor-em-producao
JWT_EXPIRACAO=7d

# Obrigatórias — Supabase Storage (upload de arquivos: fotos e documentos).
# Sem elas, o servidor nem sobe. Passo a passo em rotas.md.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads

# Opcionais — SMTP para envio de e-mails (confirmação, aprovação/reprovação,
# código de check-in). Sem eles, os e-mails só são registrados no console
# ("modo simulação"). Funciona com qualquer provedor SMTP (Resend, SendGrid,
# Gmail com senha de app, etc.) — veja o passo a passo em rotas.md.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Veteran Carclub <nao-responder@veterancarclub.com.br>
