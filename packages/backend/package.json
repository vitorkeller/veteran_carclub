{
  "name": "@veteran_carclub/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API do Veteran Car Club — Node.js + Express + PostgreSQL.",
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "test": "vitest run",
    "db:migrar": "node --env-file=.env -e \"import('./src/db.js').then(async d=>{await d.migrar();console.log('schema criado');await d.encerrar()})\""
  },
  "dependencies": {
    "express": "^4.19.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "supertest": "^7.0.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.6"
  }
}
